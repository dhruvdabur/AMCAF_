<?xml version="1.0" ?>
<sdf version='1.7'>
  <world name='custom_road_world'>
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <!-- Local ground plane and sun keep the world grounded even without Fuel access. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>25 -32 0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>180 180</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>180 180</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.54 0.56 0.54 1</ambient>
            <diffuse>0.54 0.56 0.54 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.3 -0.8</direction>
    </light>

    <!-- Legacy segmented road visuals disabled for better RTF.
         The smooth_road_overlay below provides the visible road and collision. -->

    <!-- Smooth visual/collision road overlay generated from the current road segment path. -->
    <model name="smooth_road_overlay">
      <static>true</static>
      <link name="road_surface">
        <collision name="smooth_asphalt_collision">
          <pose>0 0 0.026 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>models/smooth_road/meshes/asphalt.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="continuous_yellow_border">
          <pose>0 0 0.026 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>models/smooth_road/meshes/yellow_border.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>1.0 0.78 0.0 1.0</ambient>
            <diffuse>1.0 0.78 0.0 1.0</diffuse>
            <specular>0.08 0.08 0.06 1.0</specular>
          </material>
        </visual>
        <visual name="continuous_asphalt">
          <pose>0 0 0.029 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>models/smooth_road/meshes/asphalt.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.13 0.13 0.13 1.0</ambient>
            <diffuse>0.13 0.13 0.13 1.0</diffuse>
            <specular>0.035 0.035 0.035 1.0</specular>
          </material>
        </visual>
        <visual name="center_lane_line">
          <pose>0 0 0.033 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>models/smooth_road/meshes/center_line.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.9 1.0</ambient>
            <diffuse>0.95 0.95 0.9 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dynamic traffic and debug visual overlays disabled for better runtime performance. -->

    <include>
      <name>prius</name>
      <uri>file:///home/dhruv/amcaf/gazebo_sim/custom_worlds/models/prius</uri>
      <pose>6.089 1.763 0.35 0 0 0.006</pose>
    </include>
  </world>
</sdf>
