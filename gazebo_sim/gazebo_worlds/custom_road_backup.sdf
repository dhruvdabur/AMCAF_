<?xml version="1.0" ?>
<sdf version='1.7'>
  <world name='custom_road_world'>
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Lighting -->
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/openrobotics/models/Sun</uri>
    </include>

    
<!-- Smooth visual road overlay: hides the faceted/cut borders from the original box segments. -->
    <model name="smooth_road_overlay">
      <pose>-0.234887 -0.392366 0.0 0 0 0</pose>
      <scale>0.01 -0.01 0.01</scale>
      <static>true</static>
      <link name="road_visuals">
        <visual name="continuous_yellow_border">
          <pose>0 0 0.038 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>models/smooth_road/meshes/yellow_border.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>1.0 0.78 0.0 1.0</ambient>
            <diffuse>1.0 0.78 0.0 1.0</diffuse>
            <specular>0.08 0.08 0.06 1.0</specular>
          </material>
        </visual>
        <visual name="continuous_asphalt">
          <pose>0 0 0.044 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>models/smooth_road/meshes/asphalt.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.13 0.13 0.13 1.0</ambient>
            <diffuse>0.13 0.13 0.13 1.0</diffuse>
            <specular>0.035 0.035 0.035 1.0</specular>
          </material>
        </visual>
        <visual name="center_lane_line">
          <pose>0 0 0.052 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>models/smooth_road/meshes/center_line.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.9 1.0</ambient>
            <diffuse>0.95 0.95 0.9 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Lightweight dynamic traffic: visual actors loop on the two lanes. -->

    <actor name="traffic_car_blue">
      <pose>0.000000 0.000000 0.000000 0.000000 0.000000 0.000000</pose>
      <link name="body_link">
        <collision name="actor_chassis_collision">
          <pose>0.000000 0.000000 0.001200 0.000000 0.000000 0.000000</pose>
          <geometry>
            <box>
              <size>0.024000 0.010500 0.003500</size>
            </box>
          </geometry>
        </collision>
        <visual name="body">
          <pose>0.000000 0.000000 0.001200 0.000000 0.000000 0.000000</pose>
          <geometry>
            <box>
              <size>0.024000 0.010500 0.003500</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.20 0.95 1</ambient>
            <diffuse>0.05 0.20 0.95 1</diffuse>
            <specular>0.45 0.45 0.45 1</specular>
          </material>
        </visual>
        <visual name="cabin">
          <pose>0.001800 0.000000 0.004200 0.000000 0.000000 0.000000</pose>
          <geometry>
            <box>
              <size>0.010500 0.008600 0.003400</size>
            </box>
          </geometry>
          <material>
            <ambient>0.06 0.09 0.12 1</ambient>
            <diffuse>0.08 0.12 0.16 1</diffuse>
            <specular>0.4 0.4 0.45 1</specular>
          </material>
        </visual>
        <visual name="front_marker">
          <pose>0.012300 0.000000 0.002200 0.000000 0.000000 0.000000</pose>
          <geometry>
            <box>
              <size>0.000500 0.008200 0.001200</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.95 0.72 1</ambient>
            <diffuse>1 0.95 0.72 1</diffuse>
          </material>
        </visual>
        <visual name="rear_marker">
          <pose>-0.012300 0.000000 0.002100 0.000000 0.000000 0.000000</pose>
          <geometry>
            <box>
              <size>0.000500 0.008200 0.001200</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.04 0.03 1</ambient>
            <diffuse>0.8 0.04 0.03 1</diffuse>
          </material>
        </visual>
        <visual name="left_wheels">
          <pose>0.000000 0.005800 0.000200 1.570800 0.000000 0.000000</pose>
          <geometry>
            <cylinder>
              <radius>0.002200</radius>
              <length>0.020000</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.015 0.015 0.015 1</ambient>
            <diffuse>0.015 0.015 0.015 1</diffuse>
          </material>
        </visual>
        <visual name="right_wheels">
          <pose>0.000000 -0.005800 0.000200 1.570800 0.000000 0.000000</pose>
          <geometry>
            <cylinder>
              <radius>0.002200</radius>
              <length>0.020000</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.015 0.015 0.015 1</ambient>
            <diffuse>0.015 0.015 0.015 1</diffuse>
          </material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
